# Environment: production | development
NODE_ENV=production
PORT=3000

# Administrator bootstrap account (immutable role)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMeToAStrongPassword

# Secret used to sign session cookies and auth challenges (REQUIRED, >= 32 chars recommended)
AUTH_SECRET=

# Trust X-Forwarded-For / CF-Connecting-IP / X-Forwarded-Proto behind a reverse proxy (1 | 0)
TRUST_PROXY=1

# Optional WebAuthn (Passkey) Relying Party overrides
# Leave empty to derive automatically from the request Host (e.g. paste.example.com)
# PASSKEY_RP_ID=paste.example.com
# PASSKEY_ORIGIN=https://paste.example.com

# Optional transactional email via Resend HTTP API (for invitations and password resets)
# When omitted, the dashboard returns a manual one-time setup link instead.
RESEND_API_KEY=
MAIL_FROM=Cleanbin <no-reply@example.com>
# Leave APP_URL empty to build setup links from the active domain, or pin to https://paste.example.com
APP_URL=

# Temporary paste TTL (in days, refreshed when viewed)
PASTE_EXPIRATION_DAYS=30

# SQL Engine: SQLite (default) | PostgreSQL | MariaDB | MySQL
DATABASE__SAVE_TYPE=SQLite
DATA_DIR=./data
DATABASE__SQLITE_DB_PATH=./data/pastes.db
DATABASE__POSTGRES_URI=postgresql://postgres:postgres@localhost:5432/cleanbin
DATABASE__MARIADB_URI=mysql://root:root@localhost:3306/cleanbin

# Compression for stored paste payloads: brotli (default) | gzip | none
COMPRESSION_TYPE=brotli
COMPRESSION_QUALITY=6

# Rate limits
RATE_LIMIT_PASTE_PER_MIN=30
RATE_LIMIT_AUTH_PER_5MIN=10
RATE_LIMIT_2FA_PER_5MIN=6
